{
  "name": "gangway-kit",
  "version": "0.6.0",
  "description": "GangWay Kit — drop-in 'bridge USDC to Arc' widget + headless engine on Circle CCTP V2 with the Forwarding Service (no gas needed on Arc). EVM chains, Solana and Sui as sources.",
  "main": "gangway-kit.js",
  "browser": "gangway-kit.js",
  "files": ["gangway-kit.js", "README.md", "LICENSE"],
