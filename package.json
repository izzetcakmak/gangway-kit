    "preflight": "node test/preflight.mjs",
    "preflight:mainnet": "node test/preflight.mjs mainnet",
    "demo": "npx --yes serve -l 4173 ."
  },
  "peerDependencies": {
    "ethers": "^6.0.0"
  },
  "keywords": ["arc", "circle", "cctp", "usdc", "bridge", "forwarding-service", "ethers", "sui", "solana"],
